<?php
// Copy to <roundcube config dir>/device_mfa.inc.php (e.g. /etc/roundcubemail/device_mfa.inc.php)
// /etc/roundcubemail/device_mfa.inc.php などにコピーして編集してください

// Networks from which a new device may be registered (e.g. the internal network or its NAT address).
// Access from other addresses follows device_mfa_outside_mode below.
// 端末の「初回登録」を許可するネットワーク（院内の LAN や、外に出るときの NAT のアドレスなど）。
// ここに含まれない IP からのアクセスは、下の device_mfa_outside_mode に従います。
$config['device_mfa_register_networks'] = [
    // '192.0.2.0/24',
    // '10.0.0.0/8',
];

// Devices not used for this many days are treated as unregistered (0 = never expire)
// この日数使われなかった端末は無効扱い（0 = 無期限）
$config['device_mfa_expire_days'] = 180;

// Cookie that holds the device id / 端末IDを保持する Cookie の名前
$config['device_mfa_cookie_name'] = 'rc_device_mfa';

// Access from outside device_mfa_register_networks / 登録許可ネットワークの外からのアクセスの扱い
//  'deny' (default): only registered devices are allowed; new devices cannot be registered from outside.
//         Use this if your users sign in with a normal password (no Office 365 / identity provider MFA).
//         既定。外からは登録済みの端末だけ許可し、新しい端末は登録できない。
//         普通のパスワードでログインする環境（Office 365 などの多要素認証がない環境）では、必ずこちらにする。
//  'idp'  : skip the device check outside and rely on the identity provider's MFA.
//         Only if users sign in through an identity provider that enforces MFA outside your network
//         (e.g. Office 365 OAuth + Entra ID Conditional Access). Otherwise outside access is password-only.
//         外では端末確認をせず、ID プロバイダーの多要素認証に任せる。Office 365 の OAuth ログインで、
//         Entra ID の条件付きアクセスにより外からは多要素認証を求めている場合だけ使う。
//         そうでない環境で 'idp' にすると、外からはパスワードだけで入れてしまう。
$config['device_mfa_outside_mode'] = 'deny';
